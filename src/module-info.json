{
    "name": "Stock Tracker",
    "id": "aarontburn.Stock_Tracker",
    "version": "1.0.0",
    "author": "aarontburn",
    "description": "A template to create a module for Nexus using React.",
    "link": "https://github.com/aarontburn/nexus-stock-tracker",
    "platforms": ["win32", "linux", "darwin"],
    "author-id": "683193056e5989838dcf772c",
    "git-latest": {
        "git-username": "aarontburn",
        "git-repo-name": "nexus-stock-tracker"
    },
    "build": {
        "build-version": 1,
        "excluded": ["electron.ts"],
        "included": [],
        "process": "./process/main.js",
        "replace": [
            {
                "from": "{EXPORTED_MODULE_ID}",
                "to": "%id%",
                "at": ["./process/main.ts", "./renderer/renderer.ts"]
            },
            {
                "from": "{EXPORTED_MODULE_NAME}",
                "to": "%name%",
                "at": ["./process/main.ts"]
            }
        ]
    }
}