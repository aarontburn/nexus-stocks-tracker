{
    "name": "Stock Tracker",
    "id": "aarontburn.Stock_Tracker",
    "version": "1.0.0",
    "author": "aarontburn",
    "description": "Monitor multiple stocks in a dashboard, powered by Yahoo! Finance.",
    "link": "https://github.com/aarontburn/nexus-stock-tracker",
    "platforms": [
        "win32",
        "linux",
        "darwin"
    ],
    "author-id": "683193056e5989838dcf772c",
    "git-latest": {
        "git-username": "aarontburn",
        "git-repo-name": "nexus-stock-tracker"
    },
    "build": {
        "build-version": 1,
        "excluded": [
            "electron.ts"
        ],
        "included": [],
        "process": "./process/main.js",
        "replace": [
            {
                "from": "{EXPORTED_MODULE_ID}",
                "to": "%id%",
                "at": [
                    "./process/main.ts",
                    "./renderer/renderer.ts"
                ]
            },
            {
                "from": "{EXPORTED_MODULE_NAME}",
                "to": "%name%",
                "at": [
                    "./process/main.ts"
                ]
            },
            {
                "from": "\"{START_RENDERER}\"",
                "to": "(() => {",
                "at": [
                    "./renderer/renderer.ts"
                ]
            },
            {
                "from": "\"{END_RENDERER}\"",
                "to": "})()",
                "at": [
                    "./renderer/renderer.ts"
                ]
            },
            {
                "from": "import type",
                "to": "// import type",
                "at": [
                    "./renderer/renderer.ts"
                ]
            }
        ]
    }
}